# API 配置
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_API_TOKEN=your-api-token-here
BACKEND_API_URL=http://localhost:8080
API_TOKEN=your-backend-api-token
NEXT_PUBLIC_CAS_LOGIN_PATH=/auth/cas/login
NEXT_PUBLIC_CAS_CALLBACK_PATH=/auth/cas/callback
NEXT_PUBLIC_CAS_LOGOUT_PATH=/auth/cas/logout

# CAS 配置
CAS_ENABLED=true
CAS_SERVER_URL=https://localhost:8443/cas
CAS_CALLBACK_PATH=/auth/cas/callback
CAS_REDIRECT_URL=http://localhost:3000
CAS_DEFAULT_EMAIL_DOMAIN=cas.local
CAS_EMAIL_ATTRIBUTE=mail
CAS_NAME_ATTRIBUTE=displayName
CAS_ROLES_ATTRIBUTE=roles

# MinIO 配置
NEXT_PUBLIC_MINIO_ENDPOINT=localhost:9000
NEXT_PUBLIC_MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_REGION=us-east-1

# 数据库配置
DATABASE_URL=postgres://postgres:password@localhost:5432/robusta_hub?sslmode=disable

# 安全配置
JWT_SECRET=your-jwt-secret-key-change-this-in-production
HMAC_SECRET=your-hmac-secret-key-change-this-in-production

# 其他配置
NODE_ENV=development
PORT=8080
LOG_LEVEL=info