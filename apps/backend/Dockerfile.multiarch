# 多阶段构建：后端 Dockerfile (支持 amd64/arm64)
# 使用 buildx 进行多架构构建

# ============== 阶段 1: 基础依赖层 ==============
FROM --platform=$BUILDPLATFORM golang:1.25-alpine AS base

# 可配置的 Go 代理 (国内可设置为 https://goproxy.cn,direct)
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

WORKDIR /app
# Go 编译不需要额外安装包，golang 基础镜像已包含必要工具

# ============== 阶段 2: 依赖下载 ==============
FROM base AS deps

# 继承 GOPROXY 配置
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    go mod download && go mod verify

# ============== 阶段 3: 构建阶段 ==============
FROM --platform=$BUILDPLATFORM base AS builder

# 目标架构参数
ARG TARGETOS
ARG TARGETARCH

# 继承 GOPROXY 配置
ARG GOPROXY=https://proxy.golang.org,direct
ENV GOPROXY=${GOPROXY}

# 构建元信息
ARG VERSION=dev
ARG COMMIT_SHA=unknown
ARG BUILD_TIME=unknown

COPY . .

# 生成构建信息文件
RUN echo "{\"version\":\"${VERSION}\",\"commit\":\"${COMMIT_SHA}\",\"build_time\":\"${BUILD_TIME}\"}" > /tmp/buildinfo.json

# 交叉编译支持多架构
RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=${TARGETOS:-linux} GOARCH=${TARGETARCH:-amd64} go build \
    -ldflags="-w -s -X main.version=${VERSION} -X main.commit=${COMMIT_SHA} -X main.buildTime=${BUILD_TIME}" \
    -a -installsuffix cgo \
    -o main ./cmd/server

# ============== 阶段 4: 运行阶段 ==============
FROM alpine:3.20 AS runtime

# 设置时区
ENV TZ=UTC

# 创建用户和组（无需网络）
RUN addgroup -g 1001 -S appgroup && \
    adduser -u 1001 -S appuser -G appgroup && \
    mkdir -p /app/config && \
    chown -R appuser:appgroup /app

# 复制构建产物
COPY --from=builder /app/main /app/main
COPY --from=builder /app/migrations /app/migrations
COPY --from=builder /tmp/buildinfo.json /app/buildinfo.json

# 复制默认配置 (可被 ConfigMap 覆盖)
COPY --from=builder /app/config/config.yaml /app/config/config.yaml

# 设置权限
RUN chmod +x /app/main && \
    chown -R appuser:appgroup /app

# 切换到非 root 用户
USER appuser
WORKDIR /app

# 环境变量 - 配置文件路径 (支持 ConfigMap 挂载)
# 可以通过环境变量或直接挂载 ConfigMap 到 /app/config/config.yaml
ENV CONFIG_FILE=/app/config/config.yaml
ENV ENVIRONMENT=production
ENV GIN_MODE=release

# 暴露端口
EXPOSE 8080

# 运行应用
ENTRYPOINT ["/app/main"]
