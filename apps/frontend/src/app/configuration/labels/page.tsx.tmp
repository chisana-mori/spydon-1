
'use client';

import React, { useState } from 'react';
import { useQuery, useMutation, useQueryClient } from '@tanstack/react-query';
import {
    Plus,
    Search,
    BookOpen,
    MoreHorizontal,
    Edit,
    Trash,
    Loader2
} from 'lucide-react';
import { Dictionary, DictionaryListParams } from '@/types/dictionary';
