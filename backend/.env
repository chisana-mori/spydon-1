# 基础配置
ENVIRONMENT=development
PORT=8080

# 数据库配置
DATABASE_URL=postgres://postgres:password@localhost:5432/robusta_hub?sslmode=disable

# 安全配置
JWT_SECRET=your-jwt-secret-key-change-in-production
HMAC_SECRET=your-hmac-secret-key-change-in-production

# OIDC配置（可选）
OIDC_ISSUER=https://your-oidc-provider.com
OIDC_CLIENT_ID=your-client-id
OIDC_CLIENT_SECRET=your-client-secret

# CAS 配置
CAS_ENABLED=true
CAS_SERVER_URL=https://localhost:8443/cas
CAS_CALLBACK_PATH=/auth/cas/callback
CAS_REDIRECT_URL=http://localhost:3000
CAS_DEFAULT_EMAIL_DOMAIN=cas.local
CAS_EMAIL_ATTRIBUTE=mail
CAS_NAME_ATTRIBUTE=displayName
CAS_ROLES_ATTRIBUTE=roles

# HolmesGPT配置
HOLMES_GPT_URL=http://localhost:8081
HOLMES_GPT_API_KEY=your-holmes-api-key
HOLMES_GPT_TIMEOUT=300
HOLMES_GPT_ENABLED=true
HOLMES_GPT_DEFAULT_DEPTH=standard

# MinIO配置
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=robusta-artifacts
MINIO_USE_SSL=false

# 限流配置
RATE_LIMIT_RPS=100

# 日志配置
LOG_LEVEL=info
